import React from 'react';
import { useWindowDimensions } from 'react-native';
import YoutubePlayer from 'react-native-youtube-iframe';

export interface PlayerProps {
  videoId: string;
  playing: boolean;
  onEnded: () => void;
  onError: (reason: string) => void;
  onPlayingChange: (playing: boolean) => void;
}

/**
 * ÚNICO archivo que conoce el motor de reproducción (iframe oficial de YouTube).
 * Para cambiar a otra vía (p. ej. audio en segundo plano) basta con reescribir
 * este componente manteniendo las mismas props.
 */
export function YouTubePlayer({ videoId, playing, onEnded, onError, onPlayingChange }: PlayerProps) {
  const { width } = useWindowDimensions();
  const w = Math.max(200, width - 48);
  return (
    <YoutubePlayer
      width={w}
      height={Math.round((w * 9) / 16)}
      videoId={videoId}
      play={playing}
      onChangeState={(state: string) => {
        if (state === 'ended') onEnded();
        else if (state === 'playing') onPlayingChange(true);
        else if (state === 'paused') onPlayingChange(false);
      }}
      onError={(reason: string) => onError(reason)}
    />
  );
}
</file>

<file path="tests/helpers/nodeSqliteDb.ts">
/// <reference types="node" />
import { DatabaseSync } from 'node:sqlite';
import { Db, SqlParam } from '../../src/db/database';

/** Adaptador para probar el repositorio en Node con SQLite en memoria. */
export function createTestDb(): Db {
  const db = new DatabaseSync(':memory:');
  db.exec('PRAGMA foreign_keys = ON;');
  const bind = (p?: SqlParam[]) => (p ?? []).map(v => (v === undefined ? null : v));
  return {
    async execAsync(sql) { db.exec(sql); },
    async runAsync(sql, params) { return db.prepare(sql).run(...bind(params)); },
    async getAllAsync<T>(sql: string, params?: SqlParam[]) { return db.prepare(sql).all(...bind(params)) as T[]; },
    async getFirstAsync<T>(sql: string, params?: SqlParam[]) { return (db.prepare(sql).get(...bind(params)) as T | undefined) ?? null; },
  };
}
</file>

<file path="tests/matching-cases.md">
# Casos de prueba manuales del matching

1. Mismo título, artista diferente: debe rechazarse, nunca autoimportarse.
2. Mismo título y artista, duración muy distinta: debe revisarse o rechazarse.
3. ISRC igual, artista y título coherentes: candidato de alta confianza.
4. Versión original frente a versión live: nunca autoimportar.
5. Falta ISRC (lo normal en YouTube): solo `auto` con artista principal + título exacto + duración ±2 s + misma versión; si falta la duración, `review`.
6. Artista invitado: los `feat.` del título se extraen y cuentan como artistas; si solo coincide un artista secundario, nunca `auto`.
7. Títulos con acentos, mayúsculas y signos: normalización equivalente.
8. Dos grabaciones del mismo artista y título: comparar ISRC, duración, álbum y versión.
</file>

<file path="tests/scoreCandidate.test.ts">
import { describe, expect, it } from 'vitest';
import { normalize, scoreCandidate } from '../src/core/matching/scoreCandidate';
import { Track, TrackCandidate } from '../src/models/Track';

const track: Track = {
  id: 't1', title: 'Señorita', artists: ['Shawn Mendes', 'Camila Cabello'],
  album: 'Shawn Mendes', durationMs: 190000, isrc: 'USUM71900764',
  version: 'studio', externalIds: {},
};
const cand = (o: Partial<TrackCandidate> = {}): TrackCandidate => ({
  provider: 'youtube', externalId: 'v1', title: 'Señorita',
  artists: ['Shawn Mendes'], durationMs: 190500, version: 'studio', ...o,
});

describe('normalize', () => {
  it('quita tildes, mayúsculas y signos', () => {
    expect(normalize('  Señor   CAFÉ! ')).toBe('senor cafe');
    expect(normalize('Rock & Roll')).toBe('rock and roll');
  });
});

describe('scoreCandidate', () => {
  it('1. mismo título, artista distinto: nunca auto', () => {
    const r = scoreCandidate(track, cand({ artists: ['Otro Artista'] }));
    expect(r.decision).not.toBe('auto');
    expect(r.conflicts).toContain('Artista no coincidente');
  });
  it('3. ISRC igual + metadatos coherentes: auto', () => {
    const r = scoreCandidate(track, cand({ isrc: 'USUM71900764' }));
    expect(r.decision).toBe('auto');
  });
  it('4. original vs live: nunca auto', () => {
    const r = scoreCandidate(track, cand({ version: 'live', isrc: 'USUM71900764' }));
    expect(r.decision).not.toBe('auto');
  });
  it('2. duración muy distinta: no auto', () => {
    const r = scoreCandidate(track, cand({ durationMs: 260000, isrc: 'USUM71900764' }));
    expect(r.decision).not.toBe('auto');
  });
  it('7. acentos/mayúsculas equivalentes en título', () => {
    const r = scoreCandidate(track, cand({ title: 'SEÑORITA' }));
    expect(r.reasons).toContain('Título coincidente');
  });
});

describe('paso 2: versiones, feat. y títulos flexibles', () => {
  const t: Track = { ...track, isrc: undefined, title: 'Señorita' };
  it('"Artista - Título (Official Video)" se autoacepta si todo cuadra', () => {
    const r = scoreCandidate(t, cand({ title: 'Shawn Mendes - Señorita (Official Video)', isrc: undefined }));
    expect(r.decision).toBe('auto');
  });
  it('"(Live)" en el título de YouTube nunca es auto', () => {
    const r = scoreCandidate(t, cand({ title: 'Señorita (Live at Wembley)', isrc: undefined }));
    expect(r.conflicts).toContain('Versión diferente');
    expect(r.decision).toBe('reject');
  });
  it('feat. en el título no rompe el match de título', () => {
    const tr: Track = { ...t, title: 'Señorita (feat. Camila Cabello)' };
    const r = scoreCandidate(tr, cand({ title: 'Señorita', isrc: undefined }));
    expect(r.reasons).toContain('Título coincidente');
  });
  it('sped up / slowed se detecta como versión alterada', () => {
    const r = scoreCandidate(t, cand({ title: 'Señorita (sped up)', isrc: undefined }));
    expect(r.conflicts).toContain('Versión diferente');
  });
  it('sin duración no hay auto (solo revisión)', () => {
    const r = scoreCandidate(t, cand({ durationMs: undefined, isrc: undefined }));
    expect(r.decision).toBe('review');
  });
  it('re-grabación "(Taylor\'s Version)" no coincide con el original', () => {
    const tr: Track = { ...t, title: 'Love Story', artists: ['Taylor Swift'] };
    const r = scoreCandidate(tr, cand({ title: "Love Story (Taylor's Version)", artists: ['Taylor Swift'], isrc: undefined }));
    expect(r.decision).not.toBe('auto');
  });
});
</file>

<file path="tests/spotify.test.ts">
import { beforeEach, describe, expect, it } from 'vitest';
import { Db } from '../src/db/database';
import { migrate } from '../src/db/migrations';
import { getPlaylistEntries } from '../src/db/repository';
import { ImportError } from '../src/importers/errors';
import { artistsFromSubtitle, parseEmbedHtml } from '../src/importers/spotify/embed';
import { importSpotifyPlaylist } from '../src/importers/spotify/importPlaylist';
import { parsePlaylistId } from '../src/importers/spotify/parseUrl';
import { createTestDb } from './helpers/nodeSqliteDb';

const PL = '37i9dQZF1DXcBWIGoYBM5M';
const sid = (n: number) => String(n).padStart(22, 'A');
const item = (n: number, o: Record<string, unknown> = {}) => ({
  uri: `spotify:track:${sid(n)}`, title: `Canción ${n}`, subtitle: 'Artista Uno,\u00a0Artista Dos', duration: 200000 + n, ...o,
});
const html = (entity: unknown) =>
  `<html><script id="__NEXT_DATA__" type="application/json">${JSON.stringify({
    props: { pageProps: { state: { data: { entity } } } },
  })}</script></html>`;
const okFetch = (body: string) => async () => ({ ok: true, status: 200, text: async () => body });

const codeOf = (fn: () => unknown) => { try { fn(); } catch (e) { return (e as ImportError).code; } return null; };

describe('parsePlaylistId', () => {
  it.each([
    [`https://open.spotify.com/playlist/${PL}`],
    [`https://open.spotify.com/playlist/${PL}?si=abc123def`],
    [`https://open.spotify.com/intl-es/playlist/${PL}`],
    [`  https://open.spotify.com/embed/playlist/${PL}  `],
    [`https://open.spotify.com/user/someone/playlist/${PL}`],
    [`spotify:playlist:${PL}`],
    [PL],
  ])('acepta %s', input => expect(parsePlaylistId(input)).toBe(PL));

  it('rechaza lo que no es una playlist', () => {
    expect(codeOf(() => parsePlaylistId(`https://open.spotify.com/album/${PL}`))).toBe('not_playlist');
    expect(codeOf(() => parsePlaylistId(`https://open.spotify.com/track/${PL}`))).toBe('not_playlist');
    expect(codeOf(() => parsePlaylistId('https://spotify.link/abc123'))).toBe('short_link');
    expect(codeOf(() => parsePlaylistId('hola'))).toBe('invalid_url');
    expect(codeOf(() => parsePlaylistId(''))).toBe('invalid_url');
  });
});

describe('parseEmbedHtml', () => {
  it('lee nombre, canciones, artistas y duración', () => {
    const r = parseEmbedHtml(html({ name: 'Mi lista', trackList: [item(1), item(2)] }));
    expect(r.name).toBe('Mi lista');
    expect(r.tracks).toHaveLength(2);
    expect(r.tracks[0]).toEqual({ spotifyId: sid(1), title: 'Canción 1', artists: ['Artista Uno', 'Artista Dos'], durationMs: 200001 });
    expect(r.partial).toBe(false);
  });
  it('omite archivos locales y episodios, y los cuenta', () => {
    const r = parseEmbedHtml(html({ name: 'x', trackList: [item(1), item(2, { uri: 'spotify:local:a:b:c:d' }), item(3, { uri: `spotify:episode:${sid(3)}` })] }));
    expect(r.tracks).toHaveLength(1);
    expect(r.skipped).toBe(2);
  });
  it('avisa de lista parcial al llegar a 100', () => {
    const list = Array.from({ length: 100 }, (_, i) => item(i + 1));
    expect(parseEmbedHtml(html({ name: 'x', trackList: list })).partial).toBe(true);
  });
  it('tolera que trackList esté en otro sitio del JSON', () => {
    const page = `<script id="__NEXT_DATA__">${JSON.stringify({ a: { b: { trackList: [item(1)] } } })}</script>`;
    expect(parseEmbedHtml(page).tracks).toHaveLength(1);
  });
  it('errores claros: entidad nula y página sin datos', () => {
    expect(codeOf(() => parseEmbedHtml(html(null)))).toBe('unavailable');
    expect(codeOf(() => parseEmbedHtml('<html>nada</html>'))).toBe('parse');
    expect(codeOf(() => parseEmbedHtml('<script id="__NEXT_DATA__">{roto</script>'))).toBe('parse');
  });
  it('artistas separados por coma, con espacios duros', () => {
    expect(artistsFromSubtitle('A,\u00a0B, C')).toEqual(['A', 'B', 'C']);
    expect(artistsFromSubtitle(undefined)).toEqual([]);
  });
});

describe('importSpotifyPlaylist', () => {
  let db: Db;
  beforeEach(async () => { db = createTestDb(); await migrate(db); });
  const page = html({ name: 'Mi lista', trackList: [item(1), item(2, { title: 'Tema (Live at Wembley)' }), item(3)] });

  it('guarda canciones en orden, con versión detectada', async () => {
    const s = await importSpotifyPlaylist(db, `https://open.spotify.com/playlist/${PL}`, okFetch(page));
    expect(s).toMatchObject({ name: 'Mi lista', total: 3, newTracks: 3, partial: false });
    const entries = await getPlaylistEntries(db, s.playlistId);
    expect(entries.map(e => e.track.title)).toEqual(['Canción 1', 'Tema (Live at Wembley)', 'Canción 3']);
    expect(entries[1].track.version).toBe('live');
    expect(entries[0].track.version).toBe('studio');
  });
  it('reimportar no duplica ni canciones ni playlist', async () => {
    const a = await importSpotifyPlaylist(db, PL, okFetch(page));
    const b = await importSpotifyPlaylist(db, PL, okFetch(page));
    expect(b.playlistId).toBe(a.playlistId);
    expect(b.newTracks).toBe(0);
    const n = await db.getFirstAsync<{ n: number }>('SELECT COUNT(*) AS n FROM tracks');
    expect(n?.n).toBe(3);
  });
  it('una canción repetida en otra playlist reutiliza la misma fila', async () => {
    await importSpotifyPlaylist(db, PL, okFetch(page));
    const other = html({ name: 'Otra', trackList: [item(1), item(9)] });
    const s = await importSpotifyPlaylist(db, 'A'.repeat(22), okFetch(other));
    expect(s.newTracks).toBe(1);
  });
  it('traduce errores de red y de HTTP', async () => {
    const boom = async () => { throw new Error('offline'); };
    await expect(importSpotifyPlaylist(db, PL, boom)).rejects.toMatchObject({ code: 'network' });
    const nf = async () => ({ ok: false, status: 404, text: async () => '' });
    await expect(importSpotifyPlaylist(db, PL, nf)).rejects.toMatchObject({ code: 'unavailable' });
    const e500 = async () => ({ ok: false, status: 500, text: async () => '' });
    await expect(importSpotifyPlaylist(db, PL, e500)).rejects.toMatchObject({ code: 'network' });
  });
});
</file>

